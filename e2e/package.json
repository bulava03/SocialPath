{
  "name": "socialpath-e2e",
  "private": true,
  "type": "module",
  "description": "Browser tests for SocialPath, run against a stack of their own (docker-compose.e2e.yml, port 8081).",
  "scripts": {
    "stack:up": "docker compose -p socialpath-e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml up -d --build",
    "stack:down": "docker compose -p socialpath-e2e -f ../docker-compose.yml -f ../docker-compose.e2e.yml down -v",
    "test": "playwright test",
    "report": "playwright show-report",
    "screenshots": "node scripts/screenshots.js"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1"
  }
}
